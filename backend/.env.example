# URL interna que te da el recurso PostgreSQL de Coolify
DATABASE_URL=postgres://usuario:clave@host-interno:5432/postgres
# Cadena larga y aleatoria (ej: openssl rand -hex 32)
JWT_SECRET=cambia-esto
# Dominio(s) del frontend, separados por coma
CORS_ORIGIN=https://inventario.tudominio.com
# Administrador inicial (solo se crea si no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Solo para probar: crea edificios, modelos y un operador de ejemplo
SEED_DEMO=false
